# Hebrew calendar: ESP32-S3 + Good Display GDEM075F52 (7.5" 800x480 BWRY)
# Only applied to options not already in sdkconfig (or when sdkconfig is regenerated).

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# partitions.csv: app 1.5 MB (the default 1 MB is too small once Wi-Fi is linked
# in) + "userdata" NVS partition with the Wi-Fi and family dates (user_data.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# No PSRAM: the WROOM has none; the ESP32-S3-Zero's 2 MB quad PSRAM is not needed
# (CONFIG_SPIRAM=y + CONFIG_SPIRAM_MODE_QUAD=y if it ever is; then WROOM won't boot).
# CONFIG_SPIRAM is not set

# RTC slow clock from the 32.768 kHz crystal on GPIO15/16 (XTAL_32K_P/N), Citizen
# CM315D32768HZFT (+-5 ppm, CL 12.5 pF) with 18 pF to GND on each leg. If it does
# not start, ESP-IDF falls back to the internal RC (~0.2% = minutes per day); the
# boot log line "RTC slow clock: ..." (main.c) shows which one is used.
CONFIG_RTC_CLK_SRC_EXT_CRYS=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Internet time: up to 3 NTP servers (see main/time_sync.c)
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# LVGL (configured through Kconfig, no lv_conf.h). Keep in sync with the
# simulator's lv_conf.h in C:\work\hebrew_calendar_sim.
CONFIG_LV_COLOR_DEPTH_16=y
# LVGL allocates from the ESP heap: the landscape UI needs ~80 KB, more than a
# fixed 64 KB pool, and a bigger fixed pool would waste internal RAM
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_BIDI=y
CONFIG_LV_BASE_DIR_AUTO=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_DPI_DEF=130
# CONFIG_LV_USE_THORVG is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
