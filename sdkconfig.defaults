# Hebrew calendar: ESP32-S3 + Good Display GDEM075F52 (7.5" 800x480 BWRY)
# Only applied to options not already in sdkconfig (or when sdkconfig is regenerated).

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Current board (WROOM) has no PSRAM. The final ESP32-S3-MINI N4R2 has 2 MB quad
# PSRAM; enable it then with CONFIG_SPIRAM=y + CONFIG_SPIRAM_MODE_QUAD=y.
# CONFIG_SPIRAM is not set

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL (configured through Kconfig, no lv_conf.h). Keep in sync with the
# simulator's lv_conf.h in C:\Projects\lv_port_pc_vscode.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE=65536
CONFIG_LV_USE_BIDI=y
CONFIG_LV_BASE_DIR_AUTO=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_DPI_DEF=130
# CONFIG_LV_USE_THORVG is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
